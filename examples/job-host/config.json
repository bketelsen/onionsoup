{
  "schemaVersion": 1,
  "directory": "state",
  "port": 8787,
  "web": {
    "directory": "../../apps/web/dist",
    "invoker": "web"
  },
  "capabilities": {
    "schemaVersion": 2,
    "models": {
      "default": {
        "provider": "codex",
        "model": "gpt-5.6-terra"
      },
      "agents": {
        "change-review": {
          "provider": "copilot",
          "model": "claude-opus-5"
        },
        "chat": {
          "provider": "copilot",
          "model": "claude-sonnet-5"
        }
      }
    },
    "repositories": [
      {
        "name": "bketelsen/onionsoup",
        "checkout": "/path/to/onionsoup/checkout",
        "implementation": {
          "profile": "../repository-profiles/onionsoup-delivery.json",
          "runtime": "/private/onionsoup-runtime.json",
          "publication": "/private/publication.json",
          "target": 0
        }
      }
    ],
    "homelab": {
      "schemaVersion": 1,
      "sources": [
        {
          "sourceId": "lab-box",
          "kind": "containers",
          "target": {
            "schemaVersion": 1,
            "assetId": "lab-box",
            "host": "10.0.1.20",
            "user": "you",
            "engines": [
              "docker",
              "podman",
              "incus"
            ]
          }
        },
        {
          "sourceId": "k3s",
          "kind": "kubernetes",
          "target": {
            "schemaVersion": 1,
            "assetId": "k3s",
            "host": "10.0.1.30",
            "user": "you",
            "access": "sudo"
          }
        },
        {
          "sourceId": "nas",
          "kind": "truenas",
          "target": {
            "schemaVersion": 1,
            "assetId": "nas",
            "binary": "/path/to/truenas-mcp",
            "host": "nas.local",
            "tlsInsecure": true
          }
        }
      ],
      "truenasApiKeyFile": "/private/truenas.envrc",
      "maxAgeSeconds": 3600
    }
  },
  "invokers": [
    {
      "id": "web",
      "capabilities": [
        "repository.brief",
        "repository.search",
        "issue.readiness",
        "code.location",
        "investigation.packet",
        "change.proposal",
        "change.request",
        "change.approve",
        "change.implement",
        "change.publish",
        "repository.list",
        "repository.onboard",
        "repository.update",
        "homelab.sources",
        "homelab.add-source",
        "homelab.update-source",
        "homelab.refresh",
        "homelab.investigate",
        "homelab.brief",
        "models.assign"
      ]
    },
    {
      "id": "schedule",
      "tokenFile": "schedule.token",
      "capabilities": [
        "repository.brief"
      ],
      "maxJobs": 64
    }
  ],
  "recipes": [
    "../../examples/recipes/investigate-issue.json",
    "../../examples/recipes/issue-to-proposal.json"
  ],
  "tailscale": {
    "users": [
      {
        "login": "you@github",
        "invoker": "web"
      }
    ]
  },
  "limits": {
    "concurrency": 4
  },
  "sandbox": {
    "nodeRuntime": "/private/node-runtime.json"
  }
}
