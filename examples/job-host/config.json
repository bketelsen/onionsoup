{
  "schemaVersion": 1,
  "directory": "state",
  "port": 8787,
  "web": {
    "directory": "../../apps/web/dist",
    "invoker": "web"
  },
  "capabilities": {
    "schemaVersion": 1,
    "provider": "copilot",
    "repositories": [
      {
        "name": "bketelsen/onionsoup",
        "checkout": "/path/to/onionsoup/checkout",
        "implementation": {
          "profile": "../repository-profiles/onionsoup-delivery.json",
          "runtime": "/private/onionsoup-runtime.json",
          "publication": "/private/publication.json",
          "target": 0
        }
      }
    ]
  },
  "invokers": [
    {
      "id": "web",
      "capabilities": [
        "repository.brief",
        "issue.readiness",
        "code.location",
        "investigation.packet",
        "change.proposal",
        "change.approve",
        "change.implement",
        "change.publish"
      ]
    },
    {
      "id": "schedule",
      "tokenFile": "schedule.token",
      "capabilities": [
        "repository.brief"
      ],
      "maxJobs": 64
    }
  ],
  "recipes": [
    "../../examples/recipes/investigate-issue.json",
    "../../examples/recipes/issue-to-proposal.json"
  ]
}
