{
  "name": "onionsoup",
  "version": "0.1.0",
  "license": "MIT",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "owners": "node --conditions=onionsoup-source --import tsx packages/owners/src/cli.ts",
    "build": "node scripts/build-workspaces.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node scripts/test.mjs packages/*/test/*.test.ts scripts/*.test.mjs",
    "check:packages": "node scripts/check-packages.mjs",
    "check:docs": "node scripts/check-docs.mjs",
    "verify": "npm run build && npm run check:packages && npm run check:docs && npm run typecheck && npm run surface:typecheck && npm run surface:build && npm test",
    "surface": "node --conditions=onionsoup-source --import tsx packages/surface/src/main.ts",
    "surface:build": "npm --workspace @onionsoup/surface run web:build",
    "surface:typecheck": "npm --workspace @onionsoup/surface run web:typecheck"
  },
  "dependencies": {
    "zod": "4.3.6"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsx": "^4.20.0",
    "typescript": "5.9.3"
  },
  "workspaces": [
    "packages/*"
  ],
  "description": "Owners: persistent AI agents that own a domain, hire freelancers, and work under runtime-enforced gates."
}
