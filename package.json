{
  "name": "onionsoup",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "triage": "node --import tsx src/cli.ts",
    "demo": "node --import tsx src/cli.ts demo examples/incomplete-bug.json",
    "test": "node --import tsx --test test/*.test.ts",
    "typecheck": "tsc --noEmit",
    "verify": "npm run check:docs && npm run check:capabilities && npm run typecheck && npm test",
    "eval": "node --import tsx scripts/eval.ts",
    "batch": "node --import tsx src/batch-cli.ts",
    "inbox": "node --import tsx src/inbox-cli.ts",
    "locate": "node --import tsx src/location-cli.ts",
    "eval:location": "node --import tsx scripts/eval-location-search.ts",
    "packet": "node --import tsx src/packet-cli.ts",
    "check:docs": "node scripts/check-docs.mjs",
    "agents": "node --import tsx src/agents-cli.ts",
    "capabilities:generate": "node --import tsx scripts/generate-capabilities.ts",
    "check:capabilities": "node --import tsx scripts/generate-capabilities.ts --check",
    "mcp": "node --import tsx src/mcp-cli.ts",
    "prove:codex": "node --import tsx scripts/prove-codex-mcp.ts",
    "briefing": "node --import tsx src/briefing-cli.ts",
    "repo-brief": "node --import tsx src/repository-brief/cli.ts",
    "delivery": "tsx src/delivery/cli.ts",
    "mail-capture": "tsx src/delivery/capture-cli.ts",
    "proposal": "node --import tsx src/change-proposal/cli.ts"
  },
  "dependencies": {
    "@humanlayer/agentlayer-core": "0.0.36",
    "@humanlayer/agentlayer-provider-auth": "0.0.36",
    "@humanlayer/agentlayer-provider-github-copilot": "0.0.36",
    "@humanlayer/agentlayer-provider-openai-codex": "0.0.36",
    "@modelcontextprotocol/sdk": "1.30.0",
    "ai": "6.0.191",
    "nodemailer": "10.0.10",
    "smtp-server": "3.19.13",
    "zod": "4.3.6"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/nodemailer": "8.0.2",
    "@types/smtp-server": "3.5.13",
    "tsx": "^4.20.0",
    "typescript": "5.9.3"
  }
}
