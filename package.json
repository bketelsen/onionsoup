{
  "name": "onionsoup",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "owners": "node --conditions=onionsoup-source --import tsx packages/owners/src/cli.ts",
    "build": "node scripts/build-workspaces.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node --conditions=onionsoup-source --import tsx --test packages/*/test/*.test.ts",
    "check:packages": "node scripts/check-packages.mjs",
    "check:docs": "node scripts/check-docs.mjs",
    "verify": "npm run build && npm run check:packages && npm run check:docs && npm run typecheck && npm test",
    "desk:build": "npm --prefix extensions/owners-desk run build"
  },
  "dependencies": {},
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsx": "^4.20.0",
    "typescript": "5.9.3"
  },
  "workspaces": [
    "packages/*"
  ],
  "description": "Owners: persistent AI agents that own a domain, hire freelancers, and work under runtime-enforced gates."
}
