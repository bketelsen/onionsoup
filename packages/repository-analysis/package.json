{
  "name": "@onionsoup/repository-analysis",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "exports": {
    ".": {
      "onionsoup-source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./agents": {
      "onionsoup-source": "./src/agents.ts",
      "types": "./dist/agents.d.ts",
      "default": "./dist/agents.js"
    },
    "./capabilities": {
      "onionsoup-source": "./src/capabilities.ts",
      "types": "./dist/capabilities.d.ts",
      "default": "./dist/capabilities.js"
    },
    "./collect": {
      "onionsoup-source": "./src/collect.ts",
      "types": "./dist/collect.d.ts",
      "default": "./dist/collect.js"
    },
    "./contracts": {
      "onionsoup-source": "./src/contracts.ts",
      "types": "./dist/contracts.d.ts",
      "default": "./dist/contracts.js"
    },
    "./metrics": {
      "onionsoup-source": "./src/metrics.ts",
      "types": "./dist/metrics.d.ts",
      "default": "./dist/metrics.js"
    }
  },
  "files": [
    "dist"
  ],
  "dependencies": {
    "@humanlayer/agentlayer-core": "0.0.36",
    "@onionsoup/runtime": "0.1.0",
    "ai": "6.0.191",
    "zod": "4.3.6"
  }
}
