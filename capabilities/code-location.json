{
  "schemaVersion": 1,
  "id": "code-location",
  "capabilityVersion": 3,
  "purpose": "Locate code and model-assessed relevant tests for one matching ready bug at a pinned commit.",
  "promptVersion": "code-location-v7",
  "contracts": {
    "inputVersion": 1,
    "resultVersion": 3,
    "runVersion": 3,
    "historicalResultVersions": [
      1,
      2
    ],
    "inputSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "schemaVersion": {
          "type": "number",
          "const": 1
        },
        "issue": {
          "type": "object",
          "properties": {
            "schemaVersion": {
              "type": "number",
              "const": 1
            },
            "repository": {
              "type": "string",
              "pattern": "^[\\w.-]+\\/[\\w.-]+$"
            },
            "number": {
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991
            },
            "updatedAt": {
              "type": "string",
              "format": "date-time",
              "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z))$"
            },
            "title": {
              "type": "string",
              "minLength": 1,
              "maxLength": 500
            },
            "body": {
              "type": "string",
              "maxLength": 24000
            }
          },
          "required": [
            "schemaVersion",
            "repository",
            "number",
            "updatedAt",
            "title",
            "body"
          ],
          "additionalProperties": false
        },
        "parent": {
          "type": "object",
          "properties": {
            "runId": {
              "type": "string",
              "format": "uuid",
              "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
            },
            "inputHash": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "promptVersion": {
              "type": "string"
            },
            "kind": {
              "type": "string",
              "const": "bug_report"
            },
            "bug_readiness": {
              "type": "string",
              "const": "ready"
            },
            "summary": {
              "type": "string",
              "maxLength": 600
            }
          },
          "required": [
            "runId",
            "inputHash",
            "promptVersion",
            "kind",
            "bug_readiness",
            "summary"
          ],
          "additionalProperties": false
        },
        "repository": {
          "type": "object",
          "properties": {
            "name": {
              "type": "string",
              "pattern": "^[\\w.-]+\\/[\\w.-]+$"
            },
            "commit": {
              "type": "string",
              "pattern": "^[a-f0-9]{40}$"
            }
          },
          "required": [
            "name",
            "commit"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "schemaVersion",
        "issue",
        "parent",
        "repository"
      ],
      "additionalProperties": false
    },
    "resultSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "schemaVersion": {
          "type": "number",
          "const": 3
        },
        "status": {
          "type": "string",
          "enum": [
            "located",
            "not_located"
          ]
        },
        "summary": {
          "type": "string",
          "minLength": 1,
          "maxLength": 800
        },
        "codePointers": {
          "maxItems": 4,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1,
                "maxLength": 400
              },
              "startLine": {
                "type": "integer",
                "exclusiveMinimum": 0,
                "maximum": 9007199254740991
              },
              "endLine": {
                "type": "integer",
                "exclusiveMinimum": 0,
                "maximum": 9007199254740991
              },
              "quote": {
                "type": "string",
                "minLength": 1,
                "maxLength": 2000
              },
              "symbol": {
                "anyOf": [
                  {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 160
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "reason": {
                "type": "string",
                "minLength": 1,
                "maxLength": 500
              }
            },
            "required": [
              "path",
              "startLine",
              "endLine",
              "quote",
              "symbol",
              "reason"
            ],
            "additionalProperties": false
          }
        },
        "testPointers": {
          "maxItems": 3,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1,
                "maxLength": 400
              },
              "startLine": {
                "type": "integer",
                "exclusiveMinimum": 0,
                "maximum": 9007199254740991
              },
              "endLine": {
                "type": "integer",
                "exclusiveMinimum": 0,
                "maximum": 9007199254740991
              },
              "quote": {
                "type": "string",
                "minLength": 1,
                "maxLength": 2000
              },
              "symbol": {
                "anyOf": [
                  {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 160
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "reason": {
                "type": "string",
                "minLength": 1,
                "maxLength": 500
              },
              "relevance": {
                "type": "string",
                "enum": [
                  "direct",
                  "adjacent"
                ]
              }
            },
            "required": [
              "path",
              "startLine",
              "endLine",
              "quote",
              "symbol",
              "reason",
              "relevance"
            ],
            "additionalProperties": false
          }
        },
        "uncertainties": {
          "minItems": 1,
          "maxItems": 5,
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          }
        },
        "testSearch": {
          "type": "object",
          "properties": {
            "status": {
              "type": "string",
              "enum": [
                "completed",
                "unfinished"
              ]
            },
            "reason": {
              "type": "string",
              "minLength": 1,
              "maxLength": 500
            }
          },
          "required": [
            "status",
            "reason"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "schemaVersion",
        "status",
        "summary",
        "codePointers",
        "testPointers",
        "uncertainties",
        "testSearch"
      ],
      "additionalProperties": false
    },
    "semanticValidation": "resolveBrief and validateLocationRun additionally enforce handoff identity, inspected-source grounding, outcome invariants, and canonical overview. Relevance remains model-assessed."
  },
  "invocation": {
    "transport": "typescript-function",
    "module": "src/location-agent.ts",
    "export": "locateCode",
    "signature": "(input, options) => Promise<LocationRun>",
    "requiredOptions": [
      "model",
      "provider",
      "modelId",
      "checkout"
    ],
    "optionalOptions": [
      "signal",
      "checkpoint"
    ],
    "modelDependency": "Caller-supplied AI SDK LanguageModel, selected explicitly at the application edge.",
    "checkpoint": "Caller owns persistence; awaited admission and final snapshots. Failure prevents further work or propagates. No per-step resume.",
    "source": "Caller-acquired local Git checkout or bare clone with matching GitHub origin and pinned commit."
  },
  "lifecycle": {
    "statuses": [
      "running",
      "completed",
      "failed"
    ],
    "cancellation": "Cooperative AbortSignal",
    "durableResume": false,
    "query": "Inspect caller-persisted run records; no polling service."
  },
  "limits": {
    "steps": 12,
    "timeoutMs": 600000,
    "inspectionCalls": 12,
    "contextChars": 36000,
    "matches": 12,
    "readLines": 60,
    "readChars": 6000,
    "citationLines": 30,
    "fileBytes": 262144
  },
  "effects": {
    "githubWrites": false,
    "targetCodeExecution": false,
    "modelCalls": true,
    "sourceReads": true,
    "persistence": "Through caller checkpoint only.",
    "authority": "Manifest does not authorize invocation or effects."
  },
  "failures": {
    "beforeAdmission": [
      "invalid_input",
      "persistence_error",
      "source_unavailable"
    ],
    "recorded": [
      "provider_error",
      "no_valid_brief",
      "interrupted_or_timed_out",
      "execution_error"
    ],
    "unexpectedExceptions": "Propagate to caller; inspect persisted artifacts before deliberately retrying. Unknown outcome is not success.",
    "automaticTaskRetry": false
  },
  "resultMeaning": "Completed means a validated brief, including not_located. Direct/adjacent relevance and search completion do not prove coverage or diagnosis."
}
