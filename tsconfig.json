{
  "compilerOptions": {
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "skipLibCheck": true,
    "customConditions": [
      "onionsoup-source"
    ]
  },
  "include": [
    "packages/**/*.ts"
  ],
  "exclude": [
    "**/dist/**",
    ".build/**",
    "packages/surface/web/**"
  ]
}
