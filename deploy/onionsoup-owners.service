# Template for a manually bootstrapped release root at %h/projects/onionsoup-release.
# See docs/deployment.md before installing or starting it. This unit does not signal readiness.
[Unit]
Description=onionsoup owners daemon
After=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/projects/onionsoup-release/current
# systemd does not read ~/.bashrc, so PATH is spelled out. mise shims resolve node, go and gh to the
# versions mise selects without shell activation; brew is a fallback. The runtime also needs opencode,
# git, incus, bwrap and systemd-run (the last four are in /usr/bin here).
Environment=PATH=%h/.local/share/mise/shims:%h/.local/bin:%h/.opencode/bin:/home/linuxbrew/.linuxbrew/bin:/usr/local/bin:/usr/bin:/bin
Environment=ONIONSOUP_HOME=%h/.local/share/onionsoup
Environment=ONIONSOUP_CONFIG=%h/.config/onionsoup
ExecStart=%h/.local/share/mise/shims/node --conditions=onionsoup-source --import tsx %h/projects/onionsoup-release/current/packages/owners/src/cli.ts daemon
Restart=on-failure
RestartSec=30
# A stop marks in-flight work interrupted; nothing is replayed on the next start.
KillSignal=SIGTERM
TimeoutStopSec=30

[Install]
WantedBy=default.target
