# Always-on owners. Not installed by anything; to use it:
#   cp examples/owners/systemd/onionsoup-owners.service ~/.config/systemd/user/
#   systemctl --user daemon-reload && systemctl --user start onionsoup-owners
#   journalctl --user -u onionsoup-owners -f
# Approvals keep working while it runs: approve, approve-create, approve-delete and reject only
# record decisions, and the daemon acts on them at its next tick.
[Unit]
Description=onionsoup owners daemon
After=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/projects/onionsoup
# systemd does not read ~/.bashrc, so PATH is spelled out. mise shims resolve node, go and gh to the
# versions mise selects without shell activation; brew is a fallback. The runtime also needs opencode,
# git, incus, bwrap and systemd-run (the last four are in /usr/bin here).
Environment=PATH=%h/.local/share/mise/shims:%h/.local/bin:%h/.opencode/bin:/home/linuxbrew/.linuxbrew/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=%h/.local/share/mise/shims/node --conditions=onionsoup-source --import tsx packages/owners/src/cli.ts daemon
Restart=on-failure
RestartSec=30
# A stop marks in-flight work interrupted; nothing is replayed on the next start.
KillSignal=SIGTERM
TimeoutStopSec=30

[Install]
WantedBy=default.target
